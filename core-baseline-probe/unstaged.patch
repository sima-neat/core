+static std::optional<TerminalMlaRouteSnapshot>
+select_terminal_mla_route_snapshot(
+    const pipeline_internal::sima::static_contract::ModelExecutionPlan& full_semantic,
+    const pipeline_internal::sima::static_contract::PhysicalExecutionPlan& full_physical,
+    std::string* error) {
+  namespace sc = pipeline_internal::sima::static_contract;
+  const auto fail = [&](std::string message)
+      -> std::optional<TerminalMlaRouteSnapshot> {
+    if (error) {
+      *error = std::move(message);
+    }
+    return std::nullopt;
+  };
+  if (full_semantic.mla_stage_count() == 0U) {
+    return fail("terminal MLA route has no MLA stage");
+  }
+  const std::size_t terminal_stage_index = full_semantic.mla_stage_count() - 1U;
+  const auto* terminal_stage = full_semantic.mla_stage(terminal_stage_index);
+  if (!terminal_stage ||
+      terminal_stage->key.op_id >= full_physical.command_for_semantic_op.size()) {
+    return fail("terminal MLA route has no semantic/physical identity");
+  }
+  const auto terminal_command_id =
+      full_physical.command_for_semantic_op[terminal_stage->key.op_id];
+  if (!terminal_command_id.has_value() ||
+      *terminal_command_id >= full_physical.commands.size()) {
+    return fail("terminal MLA route has no physical command");
+  }
+  const auto& terminal_command = full_physical.commands[*terminal_command_id];
+  if (terminal_command.engine != sc::PhysicalEngine::Mla ||
+      terminal_command.outputs.empty() || terminal_command.successors.empty()) {
+    return fail("terminal MLA route has no exact removable physical successor");
+  }
+
+  std::unordered_set<sc::ValueId> terminal_roots;
+  for (const auto output : terminal_command.outputs) {
+    terminal_roots.emplace(route_root_value(full_semantic, output));
+  }
+  std::vector<sc::ValueId> boundary_values;
+  std::unordered_set<sc::ValueId> seen_boundary_values;
+  std::vector<sc::PhysicalCommandId> ordered_successors =
+      terminal_command.successors;
+  std::sort(ordered_successors.begin(), ordered_successors.end());
+  for (const auto successor_id : ordered_successors) {
+    if (successor_id >= full_physical.commands.size()) {
+      return fail("terminal MLA route references a missing successor");
+    }
+    const auto& successor = full_physical.commands[successor_id];
+    if (successor.inputs.empty()) {
+      return fail("terminal MLA successor has no exact input boundary");
+    }
+    for (const auto input : successor.inputs) {
+      if (!terminal_roots.contains(route_root_value(full_semantic, input))) {
+        return fail("terminal MLA successor reads a foreign physical root");
+      }
+      if (seen_boundary_values.emplace(input).second) {
+        boundary_values.push_back(input);
+      }
+    }
+  }
+  std::unordered_set<sc::ValueId> boundary_roots;
+  for (const auto value : boundary_values) {
+    boundary_roots.emplace(route_root_value(full_semantic, value));
+  }
+  if (boundary_values.empty() || boundary_roots != terminal_roots) {
+    return fail("terminal MLA successor boundary does not cover every physical output root");
+  }
+  if (terminal_command.outputs.size() > 1U) {
+    if (boundary_values.size() != terminal_command.outputs.size()) {
+      return fail("terminal MLA successor boundary is not bijective to its physical ports");
+    }
+    for (std::size_t index = 0U; index < boundary_values.size(); ++index) {
+      if (route_root_value(full_semantic, boundary_values[index]) !=
