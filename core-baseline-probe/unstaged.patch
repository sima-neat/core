+static bool exact_boxdecode_mla_terminal_route(
+    const InferenceTerminalPolicy& terminal_policy,
+    const std::optional<pipeline_internal::sima::ModelManagedRouteFlags>& route_flags,
+    const std::vector<ExecutionStageKind>& post_kinds) {
+  return terminal_policy.mla_only &&
+         !terminal_policy.last_stage_index.has_value() &&
+         !terminal_policy.last_stage_name.has_value() &&
+         !terminal_policy.last_plugin_id.has_value() &&
+         !terminal_policy.last_processor.has_value() && route_flags.has_value() &&
+         route_flags->boxdecode_selected && post_kinds.size() == 1U &&
+         post_kinds.front() == ExecutionStageKind::BoxDecode;
+}
+
+static pipeline_internal::sima::static_contract::ValueId route_root_value(
+    const pipeline_internal::sima::static_contract::ModelExecutionPlan& plan,
+    pipeline_internal::sima::static_contract::ValueId value_id) {
+  for (std::size_t remaining = plan.values().size() + 1U; remaining > 0U;
+       --remaining) {
+    const auto* value = plan.value(value_id);
+    if (!value || !value->read_expression.has_value()) {
+      return value_id;
+    }
+    value_id = value->read_expression->source_value_id;
+  }
+  return value_id;
+}
+
+static std::string exact_route_dtype(std::string_view dtype) {
+  if (dtype == "BF16" || dtype == "BFLOAT16" || dtype == "bfloat16") {
+    return "BF16";
+  }
+  if (dtype == "FP32" || dtype == "FLOAT32" || dtype == "float32") {
+    return "FP32";
+  }
+  return {};
+}
+
+static bool exact_boxdecode_absorbable_bf16_cast(
+    const pipeline_internal::sima::static_contract::ModelExecutionPlan& plan,
+    const pipeline_internal::sima::static_contract::PhysicalCommandMember& member,
+    const std::size_t chain_index, std::string* detail) {
+  namespace sc = pipeline_internal::sima::static_contract;
+  const auto reject = [&](std::string message) {
+    if (detail) *detail = std::move(message);
+    return false;
+  };
+  if (chain_index >= member.semantic_chain.size()) {
+    return reject("Cast lineage index is invalid");
+  }
+  const auto op_id = member.semantic_chain[chain_index];
+  if (op_id >= plan.ops().size()) {
+    return reject("Cast lineage operation is missing");
+  }
+  const auto& op = plan.ops()[op_id];
+  const auto* cast = std::get_if<sc::CastOpConfig>(&op.config);
+  if (op.kind != sc::OpKind::Cast || !cast || op.processor != "EV74" ||
+      (op.kernel != "cast_transform" && op.kernel != "cast") ||
+      op.inputs.size() != 1U || op.outputs.size() != 1U ||
+      op.input_shapes.size() != 1U || op.output_shapes.size() != 1U) {
+    return reject("Cast is not one exact registered EV74 1:1 operation");
+  }
+  if (chain_index + 1U != member.semantic_chain.size() ||
+      member.outer_outputs != op.outputs) {
+    return reject("Cast is not the terminal operation on its exact physical member");
+  }
+  if (chain_index == 0U) {
+    if (member.outer_inputs != op.inputs) {
+      return reject("Cast input is detached from its physical member input");
+    }
+  } else {
+    const auto previous_id = member.semantic_chain[chain_index - 1U];
+    if (previous_id >= plan.ops().size() ||
+        plan.ops()[previous_id].outputs != op.inputs) {
+      return reject("Cast input is detached from the preceding typed transform");
+    }
+  }
+
+  const auto* input = plan.value(op.inputs.front());
+  const auto* output = plan.value(op.outputs.front());
+  if (!input || !output || !input->logical_dtype || !output->logical_dtype ||
+      !input->logical_shape || !output->logical_shape) {
+    return reject("Cast endpoints lack exact dtype/shape facts");
+  }
+  if (exact_route_dtype(*input->logical_dtype) != "BF16" ||
+      exact_route_dtype(*output->logical_dtype) != "FP32" ||
+      exact_route_dtype(cast->output_dtype) != "FP32") {
+    return reject("Cast is not the exact BF16-to-FP32 transition owned by BoxDecode");
+  }
+  if (op.input_shapes.front() != op.output_shapes.front() ||
+      *input->logical_shape != op.input_shapes.front() ||
+      *output->logical_shape != op.output_shapes.front() ||
+      input->logical_layout != output->logical_layout) {
+    return reject("Cast changes semantic shape or layout");
+  }
+  if (input->required_bytes == 0U ||
+      input->required_bytes > std::numeric_limits<std::uint64_t>::max() / 2U ||
+      output->required_bytes != input->required_bytes * 2U) {
+    return reject("Cast endpoints do not have the exact BF16-to-FP32 byte ratio");
+  }
+  if (!input->quantization.empty() || !output->quantization.empty()) {
+    return reject("Cast endpoints unexpectedly carry quantization semantics");
+  }
+  return true;
+}
