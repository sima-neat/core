+  std::size_t semantic_cutoff = terminal_stage->key.op_id;
+  for (const auto boundary : boundary_values) {
+    const auto producer = std::find_if(
+        full_semantic.ops().begin(), full_semantic.ops().end(),
+        [&](const auto& op) {
+          return std::find(op.outputs.begin(), op.outputs.end(), boundary) !=
+                 op.outputs.end();
+        });
+    if (producer != full_semantic.ops().end()) {
