@PACKAGE_INIT@

# MSVC links a static library only with the toolset that built it or a newer one.
# clang-cl reports its own version; the MSVC toolset it uses is the one it simulates.
set(_simapcie_msvc_version "${CMAKE_CXX_COMPILER_VERSION}")
if(CMAKE_CXX_SIMULATE_VERSION)
  set(_simapcie_msvc_version "${CMAKE_CXX_SIMULATE_VERSION}")
endif()
if(MSVC AND _simapcie_msvc_version VERSION_LESS "@SIMAPCIE_MSVC_VERSION@")
  message(FATAL_ERROR "SimaPCIeHost requires MSVC @SIMAPCIE_MSVC_VERSION@ or newer; "
    "this project uses MSVC ${_simapcie_msvc_version}")
endif()
unset(_simapcie_msvc_version)

include(CMakeFindDependencyMacro)
find_dependency(PkgConfig REQUIRED)
find_dependency(Threads REQUIRED)
find_dependency(ZLIB REQUIRED)
if(NOT WIN32)
  find_dependency(nlohmann_json REQUIRED)
endif()
find_dependency(SimaScheduler CONFIG COMPONENTS @SIMAPCIE_SCHEDULER_CONFIG_COMPONENTS@)
pkg_check_modules(SIMAPCIE_GST REQUIRED IMPORTED_TARGET GLOBAL
  gstreamer-1.0
  gstreamer-app-1.0
  glib-2.0)

include("${CMAKE_CURRENT_LIST_DIR}/SimaPCIeHostTargets.cmake")
