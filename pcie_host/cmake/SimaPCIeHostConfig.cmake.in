@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(PkgConfig REQUIRED)
find_dependency(Threads REQUIRED)
find_dependency(ZLIB REQUIRED)
find_dependency(SimaScheduler CONFIG COMPONENTS @SIMAPCIE_SCHEDULER_CONFIG_COMPONENTS@)
pkg_check_modules(SIMAPCIE_GST REQUIRED IMPORTED_TARGET GLOBAL
  gstreamer-1.0
  gstreamer-app-1.0
  glib-2.0)

include("${CMAKE_CURRENT_LIST_DIR}/SimaPCIeHostTargets.cmake")
