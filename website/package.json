{
  "name": "sima-software-docs",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "start": "docusaurus start",
    "prebuild": "npm run check:i18n-complete && npm run check:i18n-navigation",
    "build": "NO_UPDATE_NOTIFIER=1 docusaurus build",
    "check:i18n": "sima-i18n check --config ../sima-i18n.config.json && node scripts/check-i18n-catalogs.js",
    "check:i18n-complete": "sima-i18n check --config ../sima-i18n.config.json --require-complete && node scripts/check-i18n-catalogs.js",
    "check:i18n-navigation": "node scripts/check-i18n-preview-navigation.js",
    "check:i18n-pilot": "node scripts/check-i18n-pilot.js",
    "translate:i18n": "sima-i18n translate --config ../sima-i18n.config.json",
    "translate:i18n-tutorials": "sima-i18n translate --config ../sima-i18n.tutorials.json",
    "gen-api-docs": "node scripts/clean-insight-api-docs.js && docusaurus gen-api-docs insight && node scripts/configure-insight-api-category.js",
    "serve": "docusaurus serve",
    "swizzle": "docusaurus swizzle"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/plugin-client-redirects": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "algoliasearch": "^5.20.0",
    "docusaurus-plugin-openapi-docs": "5.2.0",
    "docusaurus-plugin-sass": "0.2.6",
    "docusaurus-theme-openapi-docs": "5.2.0",
    "prism-react-renderer": "^2.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "overrides": {
    "serialize-javascript": "7.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
