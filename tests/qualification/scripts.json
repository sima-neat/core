{
 "schema": 1,
 "about": "Tier T3 (README.md): the Models registry's own scripts, run unchanged on each backend through launch_script.py. performance.py builds the package with the options catalogue.json records (the app view), so its expected outcome is the app row of expected.json; accuracy.py feeds the model's own tensors (the default view), so its expected outcome is the default row. datasets and models are written by make_scripts_catalogue.py from the registry; the fields above them are written by hand.",
 "source": {
  "models_registry": "models-develop 36d97e4"
 },
 "limit": 100,
 "limit_about": "accuracy.py --limit N: the first N validation images (ImageNet), a seeded sample of N images (COCO, DOTA), the first N queries against the whole database (Pittsburgh 30k)",
 "measured_fields": [
  "(^|\\.)latency(_[a-z0-9]+)*_(ms|us)$",
  "(^|\\.)(fps|throughput_fps|throughput_duration_ms|throughput_samples)$",
  "(^|\\.)(avg_power_watts|peak_power_watts|energy_joules)$",
  "(^|\\.)telemetry\\.(samples|duration_ms|sample_interval_ms)$",
  "(^|\\.)telemetry\\..*(samples|mean|minimum|maximum|last)$",
  "(^|\\.)details\\.inference_seconds$"
 ],
 "measured_about": "Report fields that are measurements: present on both backends and filled alike (zero on both or non-zero on both), their values not compared. Every other field of every report file must be equal.",
