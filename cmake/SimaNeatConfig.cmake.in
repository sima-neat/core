@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
set(SimaNeat_ABI_VERSION "@SIMANEAT_ABI_VERSION@")
set(SIMANEAT_MODELZOO_VERSION "@SIMANEAT_MODELZOO_VERSION@")
set(SIMANEAT_WITH_LLIMA @SIMANEAT_CONFIG_WITH_LLIMA@)
find_dependency(PkgConfig)
find_dependency(nlohmann_json CONFIG)
pkg_check_modules(_SimaNeat_GST REQUIRED
  gstreamer-1.0 gstreamer-app-1.0 gstreamer-video-1.0 gstreamer-allocators-1.0
  gstreamer-sdp-1.0 gstreamer-rtsp-server-1.0 glib-2.0)
pkg_check_modules(_SimaNeat_OpenCV REQUIRED opencv4)

if (NOT TARGET SimaNeat::sima_neat)
  include("${CMAKE_CURRENT_LIST_DIR}/SimaNeatTargets.cmake")
  set_property(TARGET SimaNeat::sima_neat_common APPEND PROPERTY
    INTERFACE_INCLUDE_DIRECTORIES ${_SimaNeat_GST_INCLUDE_DIRS} ${_SimaNeat_OpenCV_INCLUDE_DIRS})
  set_property(TARGET SimaNeat::sima_neat_common APPEND PROPERTY
    INTERFACE_LINK_DIRECTORIES ${_SimaNeat_GST_LIBRARY_DIRS} ${_SimaNeat_OpenCV_LIBRARY_DIRS})
endif()

if ("Static" IN_LIST SimaNeat_FIND_COMPONENTS)
  find_dependency(NeatInternals CONFIG REQUIRED)
  find_dependency(ZLIB)
  if (SIMANEAT_WITH_LLIMA)
    find_dependency(SimaLMM CONFIG REQUIRED)
    pkg_check_modules(HTTPLIB REQUIRED IMPORTED_TARGET cpp-httplib)
  endif()
  if (NOT TARGET SimaNeat::Memory)
    find_library(_SimaNeat_MEMORY_LIBRARY NAMES simaaimem REQUIRED)
    add_library(SimaNeat::Memory UNKNOWN IMPORTED)
    set_target_properties(SimaNeat::Memory PROPERTIES
      IMPORTED_LOCATION "${_SimaNeat_MEMORY_LIBRARY}")
  endif()
  include("${CMAKE_CURRENT_LIST_DIR}/SimaNeatStaticTargets.cmake")
  set(SimaNeat_Static_FOUND TRUE)
endif()

check_required_components(SimaNeat)
