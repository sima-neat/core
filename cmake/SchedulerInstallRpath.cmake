# Keep only the selected Scheduler's install layout, never its SDK/staging
# prefix. PACKAGE_PREFIX_DIR is deliberately not used: dependency discovery may
# overwrite it after Scheduler has populated its namespaced exports.
function(simaneat_scheduler_install_rpath output)
  if(NOT IS_ABSOLUTE "${SimaScheduler_BUILD_RECEIPT}")
    message(FATAL_ERROR "Scheduler must export an absolute SimaScheduler_BUILD_RECEIPT")
  endif()
  get_filename_component(_receipt "${SimaScheduler_BUILD_RECEIPT}" ABSOLUTE)
  if(NOT _receipt MATCHES "/share/SimaScheduler/buildinfo[.]json$")
    message(FATAL_ERROR "Scheduler receipt must use share/SimaScheduler/buildinfo.json")
  endif()
  # This is Scheduler's declared install anchor; analysis/source configurations
  # need not have generated the JSON file yet.
  get_filename_component(_scheduler_prefix "${_receipt}" DIRECTORY)
  get_filename_component(_scheduler_prefix "${_scheduler_prefix}" DIRECTORY)
  get_filename_component(_scheduler_prefix "${_scheduler_prefix}" DIRECTORY)

  set(_layout_root "/__sima_neat_install_prefix")
  set(_core_libdir "${CMAKE_INSTALL_LIBDIR}")
  if(_core_libdir STREQUAL "")
    message(FATAL_ERROR "Core CMAKE_INSTALL_LIBDIR must not be empty")
  endif()
  if(IS_ABSOLUTE "${_core_libdir}")
    get_filename_component(_core_prefix "${CMAKE_INSTALL_PREFIX}" ABSOLUTE)
    file(RELATIVE_PATH _core_libdir "${_core_prefix}" "${_core_libdir}")
  endif()
  get_filename_component(_core_directory "${_core_libdir}" ABSOLUTE BASE_DIR "${_layout_root}")
  file(RELATIVE_PATH _core_relative "${_layout_root}" "${_core_directory}")
  if(_core_relative MATCHES "^[.][.](/|$)")
    message(FATAL_ERROR "Core CMAKE_INSTALL_LIBDIR must remain within its install prefix")
  endif()

  set(_rpath)
  foreach(_export SimaScheduler_RUNTIME_DIR SimaScheduler_PLUGIN_DIR)
    if(NOT IS_ABSOLUTE "${${_export}}")
      message(FATAL_ERROR "Scheduler must export an absolute ${_export}")
    endif()
    get_filename_component(_provider_directory "${${_export}}" ABSOLUTE)
    file(RELATIVE_PATH _provider_relative "${_scheduler_prefix}" "${_provider_directory}")
    if(_provider_relative MATCHES "^[.][.](/|$)")
      message(FATAL_ERROR "${_export} must remain within the selected Scheduler receipt prefix")
    endif()
    file(RELATIVE_PATH _from_core "${_core_directory}" "${_layout_root}/${_provider_relative}")
    list(APPEND _rpath "$ORIGIN/${_from_core}")
  endforeach()
  list(REMOVE_DUPLICATES _rpath)
  set(${output} "${_rpath}" PARENT_SCOPE)
endfunction()
